# NOTE: This file is for the Node runtime (dev server / VPS / Docker / Render).
# On Cloudflare Workers the same values come from wrangler.toml [vars] and
# `npx wrangler secret put ...` (BOT_TOKEN, ADMIN_SECRET) — see README.

# ==============================================
# Telegram Airdrop Bot & TON Mini App Config
# ==============================================

# 1. Telegram Bot Token from @BotFather (Required for live Telegram Bot)
BOT_TOKEN=

# 2. Bot Username without '@' (Auto-detected if BOT_TOKEN is set; fallback used in Demo Mode)
BOT_USERNAME=NovaDropBot

# 3. Public HTTPS URL where this Mini App is hosted (e.g., https://airdrop.yourdomain.com)
# Required by Telegram Mini Apps & TON Connect manifest in production.
WEBAPP_URL=

# 4. Comma-separated Telegram User IDs allowed to access /admin in Bot & Web Admin Panel
# Find your numeric ID via @userinfobot on Telegram (e.g., 123456789,987654321)
ADMIN_IDS=

# 5. Optional password/key to unlock the Web Admin Panel from outside Telegram
ADMIN_SECRET=admin123

# 6. Server Port (Binds to 0.0.0.0)
PORT=3000

# 7. Allow Browser Sandbox / Demo Mode outside Telegram (true for local/preview testing, set false in strict prod)
ALLOW_DEMO_MODE=true

# 8. Optional: absolute path to the SQLite file (useful on hosts with a mounted volume)
# e.g. DATABASE_PATH=/var/data/airdrop.db  (default: ./data/airdrop.db)
DATABASE_PATH=

# 9. Default Token Branding (Can also be edited live in the Admin Panel)
TOKEN_NAME=NovaTON
TOKEN_SYMBOL=NOVA
